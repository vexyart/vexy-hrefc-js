# this_file: docs/Gemfile
# Local preview:  cd docs && bundle install && bundle exec jekyll serve
# GitHub Pages builds this automatically from the repo's /docs folder.
source "https://rubygems.org"

gem "jekyll", "~> 4.3"
gem "just-the-docs", "~> 0.10"
gem "jekyll-remote-theme"

# Windows / JRuby tzinfo support, harmless elsewhere.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
